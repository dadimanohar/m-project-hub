{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "48rem",
      "wideSize": "80rem"
    },
    "color": {
      "palette": [
        { "slug": "background", "color": "#ffffff", "name": "Background" },
        { "slug": "foreground", "color": "#161b26", "name": "Foreground" },
        { "slug": "primary", "color": "#22a7e0", "name": "Primary (Electric Cyan)" },
        { "slug": "primary-text", "color": "#0369a1", "name": "Primary Text (Accessible)" },
        { "slug": "primary-foreground", "color": "#ffffff", "name": "Primary Foreground" },
        { "slug": "ink", "color": "#0e1116", "name": "Ink" },
        { "slug": "ink-foreground", "color": "#f4f7f9", "name": "Ink Foreground" },
        { "slug": "mist", "color": "#f4f8fb", "name": "Mist" },
        { "slug": "muted-foreground", "color": "#5b6472", "name": "Muted Foreground" },
        { "slug": "amber", "color": "#f5a623", "name": "Amber" },
        { "slug": "border", "color": "#dde4ea", "name": "Border" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Space Grotesk",
          "fontFamily": "'Space Grotesk', ui-sans-serif, system-ui, sans-serif"
        },
        {
          "slug": "body",
          "name": "DM Sans",
          "fontFamily": "'DM Sans', ui-sans-serif, system-ui, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "1.75rem", "name": "Extra Large" },
        { "slug": "xx-large", "size": "2.5rem", "name": "Huge" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "lineHeight": "1.15"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--primary-text)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--primary-foreground)"
        },
        "border": { "radius": "9999px" },
        "typography": { "fontWeight": "600" },
        ":hover": {
          "color": { "background": "#1b8fc2" }
        }
      }
    },
    "blocks": {
      "core/details": {
        "border": { "color": "var(--wp--preset--color--border)", "style": "solid", "width": "0 0 1px 0" },
        "spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem" } }
      }
    }
  }
}
